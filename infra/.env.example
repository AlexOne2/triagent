# Local development defaults only.
# Change these values before any shared, persistent, or externally reachable deployment.

FRONTEND_PORT=3000
BACKEND_PORT=8000

POSTGRES_USER=triagent
POSTGRES_PASSWORD=triagent
POSTGRES_DB=triagent
DATABASE_URL=postgresql+psycopg2://triagent:triagent@postgres:5432/triagent

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
REPORTER_HASH_SALT=change-me
CORS_ORIGINS=http://localhost:3000

AUTH_MODE=session_rbac
AUTH_SESSION_TTL_MINUTES=480
AUTH_LEGACY_BASIC_ENABLED=true
AUTH_PASSWORD_MIN_LENGTH=14
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_WINDOW_MINUTES=15
AUTH_LOCKOUT_DURATION_MINUTES=15
AUTH_DNS_ENABLED=true
AUTH_DNS_TIMEOUT_SECONDS=2.0

AUDIT_RETENTION_DAYS=395
AUDIT_EXPORT_ENABLED=true
AUDIT_EXPORT_STORAGE=filesystem
AUDIT_EXPORT_BUCKET=triagent-audit
AUDIT_EXPORT_PATH=/tmp/triagent-audit
AUDIT_MAX_METADATA_BYTES=8192

NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=triagent
