# Local development defaults only.
# Change these values before any shared, persistent, or externally reachable deployment.

FRONTEND_PORT=3000
BACKEND_PORT=8000

POSTGRES_USER=triagent
POSTGRES_PASSWORD=triagent
POSTGRES_DB=triagent
DATABASE_URL=postgresql+psycopg2://triagent:triagent@postgres:5432/triagent

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
REPORTER_HASH_SALT=change-me
CORS_ORIGINS=http://localhost:3000

AUTH_MODE=session_rbac
AUTH_SESSION_TTL_MINUTES=480
AUTH_LEGACY_BASIC_ENABLED=true
AUTH_PASSWORD_MIN_LENGTH=14
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_WINDOW_MINUTES=15
AUTH_LOCKOUT_DURATION_MINUTES=15
AUTH_DNS_ENABLED=true
AUTH_DNS_TIMEOUT_SECONDS=2.0
PUBLIC_DEMO_RATE_LIMIT=20
PUBLIC_DEMO_RATE_WINDOW_SECONDS=600
PUBLIC_WAITLIST_RATE_LIMIT=10
PUBLIC_WAITLIST_RATE_WINDOW_SECONDS=3600
AUTH_LDAP_ENABLED=false
AUTH_LDAP_SERVER_URI=ldaps://ldap.example.internal:636
AUTH_LDAP_BIND_DN=cn=triagent,ou=service-accounts,dc=example,dc=internal
AUTH_LDAP_BIND_PASSWORD=change-me
AUTH_LDAP_BASE_DN=dc=example,dc=internal
AUTH_LDAP_USER_FILTER=(&(objectClass=person)(|(uid={username})(sAMAccountName={username})(userPrincipalName={username})))
AUTH_LDAP_GROUP_ATTRIBUTE=memberOf
AUTH_LDAP_EMAIL_ATTRIBUTE=mail
AUTH_LDAP_START_TLS=false
AUTH_LDAP_VERIFY_CERTS=true
AUTH_LDAP_TIMEOUT_SECONDS=5.0
AUTH_LDAP_GROUP_ROLE_MAP={"triagent-admins":"ADMIN","triagent-analysts":"ANALYST","triagent-ingestors":"INGESTOR"}

AUDIT_RETENTION_DAYS=395
AUDIT_EXPORT_ENABLED=true
AUDIT_EXPORT_STORAGE=filesystem
AUDIT_EXPORT_BUCKET=triagent-audit
AUDIT_EXPORT_PATH=/tmp/triagent-audit
AUDIT_MAX_METADATA_BYTES=8192

NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=triagent
